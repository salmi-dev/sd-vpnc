#!/bin/sh

set -eu

PROGRAM=${0##*/}
VERSION=0.3.4
IMAGE="localhost/sd-vpnc:$VERSION"
CONTAINER_NAME="sd-vpnc-$(id -u)"
TUN_CONTAINER_NAME="sd-vpnc-tun-$(id -u)"

RESET=
BOLD=
DIM=
CYAN=
GREEN=
YELLOW=
RED=

use_color=0
case ${SD_VPNC_COLOR:-auto} in
	always) use_color=1 ;;
	never) use_color=0 ;;
	*)
		if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
			use_color=1
		fi
		;;
esac

if [ "$use_color" = 1 ]; then
	ESC=$(printf '\033')
	RESET="${ESC}[0m"
	BOLD="${ESC}[1m"
	DIM="${ESC}[2m"
	CYAN="${ESC}[36m"
	GREEN="${ESC}[32m"
	YELLOW="${ESC}[33m"
	RED="${ESC}[31m"
fi

style() {
	printf '%s%s%s' "$1" "$2" "$RESET"
}

banner() {
	cat <<EOF

$(style "$CYAN" '██╗   ██╗██████╗ ███╗   ██╗') $(style "$GREEN" '██████╗')
$(style "$CYAN" '██║   ██║██╔══██╗████╗  ██║')$(style "$GREEN" '██╔════╝')
$(style "$CYAN" '██║   ██║██████╔╝██╔██╗ ██║')$(style "$GREEN" '██║     ')
$(style "$CYAN" '╚██╗ ██╔╝██╔═══╝ ██║╚██╗██║')$(style "$GREEN" '██║     ')
$(style "$CYAN" ' ╚████╔╝ ██║     ██║ ╚████║')$(style "$GREEN" '╚██████╗')
$(style "$CYAN" '  ╚═══╝  ╚═╝     ╚═╝  ╚═══╝')$(style "$GREEN" ' ╚═════╝')
EOF
}

usage() {
	cat <<EOF
$(banner)

${BOLD}sd-vpnc${RESET} ${DIM}v$VERSION${RESET} - OpenVPN container client

${BOLD}Usage${RESET}:
  $PROGRAM [global-options] <command> [command-options] [arguments]

${BOLD}Commands${RESET}:
  init [--force]                     Create the configuration and work directories
  status                             Show configuration, runtime, and image status
  agent                              Print usage guidance for AI agents
  ssh [ssh-arguments ...]            Connect the VPN; bare command opens local shell, otherwise forward to ssh
  ssh-tmux <ssh-host> [tmux-session] Connect SSH with an optional tmux session
  tun <ssh-host> <mapping...>        Start host-accessible local tunnels in background
  tun --stop                         Stop the background tunnel container
  tun-add-port <mapping> [--yes]     Add one mapping to a managed tunnel
  tun-rm-port <local-port> [--yes]   Remove one mapping from a managed tunnel
  shell                              Open a shell in the VPN container (starts it if needed)
  image [--rebuild]                  Build or rebuild the local container image
  version                            Print the version

${BOLD}Global options${RESET}:
  -C, --workdir DIR  Mount DIR as the container's /work directory
  --rebuild          Rebuild the image before running a connection command
  -h, --help         Show this help
  -v, --version      Show the version

Use '$PROGRAM status' to inspect the current setup.
Use '$PROGRAM init' before the first connection.
Use '$PROGRAM agent' for instructions intended for AI agents.

Configuration defaults:
  $config_dir/client.ovpn
  $config_dir/credentials
  $ssh_config
  $workdir  (container /work)
EOF
}

version() {
	if [ -t 1 ]; then
		banner
		printf '%s %s\n' "$(style "$BOLD" sd-vpnc)" "v$VERSION"
	else
		printf '%s\n' "$VERSION"
	fi
}

die() {
	printf '%s %s\n' "$(style "$RED" error)" "$*" >&2
	exit 1
}

need_dir() {
	[ -d "$1" ] || die "Directory not found: $1"
}

container_command=

quote_shell_argument() {
	quoted_value=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")
	printf "'%s'" "$quoted_value"
}

build_image() (
	dotfiles_repo=${SD_VPNC_DOTFILES:-}
	dotfiles_ref=${SD_VPNC_DOTFILES_REF:-}
	if [ -z "$dotfiles_repo" ] && [ -n "$dotfiles_ref" ]; then
		die "SD_VPNC_DOTFILES_REF requires SD_VPNC_DOTFILES."
	fi
	case $dotfiles_ref in
		-*) die "SD_VPNC_DOTFILES_REF must not start with '-'." ;;
	esac

	cache_home=${XDG_CACHE_HOME:-"$HOME/.cache"}
	build_root="$cache_home/sd-vpnc"
	mkdir -p "$build_root"
	if [ -n "$dotfiles_repo" ]; then
		build_dir=$(mktemp -d "$build_root/build.XXXXXX") || die "Failed to create the image build context."
		trap 'rm -rf "$build_dir"' 0
		trap 'exit 1' HUP INT TERM
		checkout_dir="$build_dir/dotfiles"
		command -v git >/dev/null 2>&1 || die "Git is required to clone the configured dotfiles repository."
		if [ -n "${GIT_SSH_COMMAND:-}" ]; then
			git_ssh_command="$GIT_SSH_COMMAND"
		else
			if core_ssh_command=$(git config --global --get core.sshCommand 2>/dev/null); then
				:
			elif core_ssh_command=$(git config --system --get core.sshCommand 2>/dev/null); then
				:
			else
				core_ssh_command=
			fi
			if [ -n "$core_ssh_command" ]; then
				git_ssh_command="$core_ssh_command"
			elif [ -n "${GIT_SSH:-}" ]; then
				git_ssh_command=$(quote_shell_argument "$GIT_SSH")
			else
				git_ssh_command=ssh
			fi
		fi
		git_ssh_command="$git_ssh_command -o BatchMode=yes"
		if ! GIT_SSH_COMMAND="$git_ssh_command" GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false SSH_ASKPASS_REQUIRE=never GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never git -c submodule.recurse=false clone -- "$dotfiles_repo" "$checkout_dir" </dev/null >/dev/null 2>&1; then
			die "Failed to clone the configured dotfiles repository."
		fi
		if [ -n "$dotfiles_ref" ]; then
			dotfiles_commit=
			for ref_namespace in heads tags; do
				if dotfiles_commit=$(git -C "$checkout_dir" rev-parse --verify "refs/$ref_namespace/$dotfiles_ref^{commit}" 2>/dev/null); then
					break
				fi
			done
			if [ -z "$dotfiles_commit" ]; then
				remote_names=$(git -C "$checkout_dir" remote 2>/dev/null || true)
				old_ifs=$IFS
				IFS='
'
				case $- in *f*) glob_was_disabled=1 ;; *) glob_was_disabled=0 ;; esac
				set -f
				for remote_name in $remote_names; do
					if dotfiles_commit=$(git -C "$checkout_dir" rev-parse --verify "refs/remotes/$remote_name/$dotfiles_ref^{commit}" 2>/dev/null); then
						break
					fi
				done
				IFS=$old_ifs
				[ "$glob_was_disabled" = 1 ] || set +f
			fi
			if [ -z "$dotfiles_commit" ]; then
				dotfiles_commit=$(git -C "$checkout_dir" rev-parse --verify "$dotfiles_ref^{commit}" 2>/dev/null) || die "Failed to select the configured dotfiles ref."
			fi
			if ! GIT_SSH_COMMAND="$git_ssh_command" GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false SSH_ASKPASS_REQUIRE=never GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never git -c submodule.recurse=false -C "$checkout_dir" checkout --detach "$dotfiles_commit" </dev/null >/dev/null 2>&1; then
				die "Failed to select the configured dotfiles ref."
			fi
		fi
		# The installer sees only a self-contained checkout: no remote URL or
		# credentials, no clone reflog naming the source, and no references to
		# host repositories through alternates for the selected commit and its
		# reachable history (unreachable objects are not guaranteed).
		git_metadata_dir="$checkout_dir/.git"
		remote_names=$(git -C "$checkout_dir" remote 2>/dev/null) || die "Failed to sanitize Git metadata from the dotfiles repository."
		for remote_name in $remote_names; do
			git -C "$checkout_dir" remote remove "$remote_name" >/dev/null 2>&1 || die "Failed to sanitize Git metadata from the dotfiles repository."
		done
		if ! rm -rf "$git_metadata_dir/logs" "$git_metadata_dir/FETCH_HEAD" "$git_metadata_dir/ORIG_HEAD"; then
			die "Failed to sanitize Git metadata from the dotfiles repository."
		fi
		if [ -e "$git_metadata_dir/objects/info/alternates" ] || [ -e "$git_metadata_dir/objects/info/http-alternates" ]; then
			git -C "$checkout_dir" repack -a -d -q </dev/null >/dev/null 2>&1 || die "Failed to make Git metadata self-contained."
			rm -f "$git_metadata_dir/objects/info/alternates" "$git_metadata_dir/objects/info/http-alternates" || die "Failed to make Git metadata self-contained."
		fi
		if ! mv "$git_metadata_dir" "$build_dir/dotfiles-git"; then
			die "Failed to separate Git metadata from the dotfiles repository."
		fi
	else
		build_dir="$build_root/build"
		rm -rf "$build_dir/dotfiles"
		mkdir -p "$build_dir"
	fi

	cat >"$build_dir/Containerfile" <<'CONTAINERFILE'
FROM fedora:42

LABEL org.opencontainers.image.title="sd-vpnc" \
      org.opencontainers.image.description="Containerized OpenVPN client with SSH access"

RUN dnf -y install \
      bash \
      ca-certificates \
      iproute \
      openssh-clients \
      openvpn \
      procps-ng \
      tmux \
      util-linux \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN mkdir -p /config /home/dev /work && chmod 0755 /home/dev

COPY entrypoint.sh /usr/local/bin/sd-vpnc-entrypoint
COPY home-init.sh /usr/local/lib/sd-vpnc-home-init.sh
COPY sd-vpnc-shell /usr/local/bin/sd-vpnc-shell
COPY sd-vpnc-session-registry /usr/local/bin/sd-vpnc-session-registry
RUN chmod 0755 /usr/local/bin/sd-vpnc-entrypoint /usr/local/bin/sd-vpnc-shell /usr/local/bin/sd-vpnc-session-registry

ENV HOME=/home/dev \
    XDG_CACHE_HOME=/home/dev/.cache \
    XDG_STATE_HOME=/home/dev/.local/state \
    XDG_DATA_HOME=/home/dev/.local/share \
    ATUIN_HOME=/home/dev/.atuin
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/sd-vpnc-entrypoint"]
CONTAINERFILE

	cat >"$build_dir/entrypoint.sh" <<'ENTRYPOINT'
#!/usr/bin/env bash
set -euo pipefail

mode=${1:-shell}
if [[ $# -gt 0 ]]; then
  shift
fi

case "$mode" in
  session)
    exec /usr/local/bin/sd-vpnc-session-registry launch "$@"
    ;;
  status|ready)
    exec /usr/local/bin/sd-vpnc-session-registry "$mode"
    ;;
  manager|ssh|ssh-tmux|tun) ;;
  *) echo "Unknown container command: $mode" >&2; exit 2 ;;
esac

if [[ "$mode" == manager ]]; then
  rm -f /tmp/sd-vpnc-manager-ready /tmp/sd-vpnc-vpn-ready
  /usr/local/bin/sd-vpnc-session-registry initialize
fi

. /usr/local/lib/sd-vpnc-home-init.sh
sd_vpnc_seed_home /usr/share/sd-vpnc/home-template

config=/config/client.ovpn
credentials=/config/credentials
vpn_config=/tmp/client.ovpn
pidfile=/tmp/openvpn.pid
logfile=/tmp/openvpn.log

cd /work
if [[ ! -r "$config" ]]; then
  echo "VPN configuration not found: $config" >&2
  echo "Create ~/.config/sd-vpnc/client.ovpn or set SD_VPNC_CONFIG." >&2
  exit 1
fi
cp "$config" "$vpn_config"
if [[ -r "$credentials" ]]; then
  printf '\nauth-user-pass %s\n' "$credentials" >> "$vpn_config"
fi

openvpn --config "$vpn_config" --daemon vpn-ssh-openvpn --writepid "$pidfile" --log "$logfile"
cleanup() {
  if [[ -n "${ssh_pid:-}" ]]; then
    kill "$ssh_pid" 2>/dev/null || true
  fi
  if [[ -s "$pidfile" ]]; then
    kill "$(<"$pidfile")" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 0' INT TERM

for _ in {1..60}; do
  if compgen -G '/sys/class/net/tun*' >/dev/null; then break; fi
  if [[ -s "$pidfile" ]] && ! kill -0 "$(<"$pidfile")" 2>/dev/null; then
    echo "OpenVPN failed to start:" >&2
    cat "$logfile" >&2 || true
    exit 1
  fi
  sleep 1
done
if ! compgen -G '/sys/class/net/tun*' >/dev/null; then
  echo "Timed out waiting for the VPN tunnel." >&2
  cat "$logfile" >&2 || true
  exit 1
fi
touch /tmp/sd-vpnc-vpn-ready

ssh_args=()
if [[ -f "$HOME/.ssh/config" ]]; then ssh_args=(-F "$HOME/.ssh/config"); fi
run_client() {
  case "$mode" in
    ssh)
      if [[ $# -gt 0 ]]; then
        ssh "${ssh_args[@]}" "$@"
      else
        echo "VPN is connected. OpenVPN log: $logfile"
        /usr/local/bin/sd-vpnc-shell
      fi
      ;;
    ssh-tmux)
      host=${1:-}
      session=${2:-}
      if [[ -z "$host" ]]; then echo "A host is required for ssh-tmux." >&2; return 2; fi
      if [[ -n "$session" && ! "$session" =~ ^[[:alnum:]_.-]+$ ]]; then
        echo "tmux session names may contain only letters, numbers, ., _, and -." >&2
        return 2
      fi
      if [[ -n "$session" ]]; then
        ssh "${ssh_args[@]}" "$host" -t "tmux new -s '$session' || tmux attach -t '$session'"
      else
        ssh "${ssh_args[@]}" "$host"
      fi
      ;;
    tun)
      host=${1:-}
      if [[ -z "$host" ]]; then echo "A host is required for tun." >&2; return 2; fi
      shift
      tunnel_args=()
      tunnel_ports=()
      while [[ $# -gt 0 ]]; do
        mapping=$1; shift
        case $mapping in
          *:*:*) local_port=${mapping%%:*}; remainder=${mapping#*:}; remote_host=${remainder%:*}; remote_port=${remainder##*:} ;;
          *:*) local_port=${mapping%%:*}; remote_host=localhost; remote_port=${mapping#*:} ;;
          *) echo "Invalid port mapping: $mapping" >&2; return 2 ;;
        esac
        if [[ ! "$local_port" =~ ^[0-9]+$ || ! "$remote_port" =~ ^[0-9]+$ || ! "$remote_host" =~ ^[[:alnum:]._-]+$ ]]; then
          echo "Invalid port mapping: $mapping" >&2; return 2
        fi
        tunnel_args+=(-L "0.0.0.0:$local_port:$remote_host:$remote_port")
        tunnel_ports+=("$local_port")
      done
      ssh_log=/tmp/sd-vpnc-tun-ssh.log
      ssh -v -N -T -o BatchMode=yes -o ConnectTimeout=20 -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=30 -o ServerAliveCountMax=3 "${ssh_args[@]}" "${tunnel_args[@]}" "$host" >"$ssh_log" 2>&1 &
      ssh_pid=$!
      for _ in {1..45}; do
        if ! kill -0 "$ssh_pid" 2>/dev/null; then
          ssh_status=0; wait "$ssh_pid" || ssh_status=$?; cat "$ssh_log" >&2; return "$ssh_status"
        fi
        forwards_ready=1
        for local_port in "${tunnel_ports[@]}"; do
          if ! grep -Fq "Local forwarding listening on 0.0.0.0 port $local_port." "$ssh_log"; then forwards_ready=0; break; fi
        done
        if [[ "$forwards_ready" = 1 ]]; then
          touch /tmp/sd-vpnc-tun-ready
          echo "SSH tunnel is ready on the published local port(s)."
          wait "$ssh_pid"
          return $?
        fi
        sleep 1
      done
      echo "Timed out waiting for SSH tunnel setup." >&2
      cat "$ssh_log" >&2 || true
      kill "$ssh_pid" 2>/dev/null || true
      wait "$ssh_pid" 2>/dev/null || true
      return 1
      ;;
  esac
}

if [[ "$mode" == manager ]]; then
  /usr/local/bin/sd-vpnc-session-registry start-grace
  /usr/local/bin/sd-vpnc-session-registry watch &
  watcher_pid=$!
  /usr/local/bin/sd-vpnc-session-registry mark-ready
  wait "$watcher_pid"
  exit 0
fi
run_client "$@"
ENTRYPOINT

	cat >"$build_dir/sd-vpnc-session-registry" <<'REGISTRY'
#!/usr/bin/env bash
set -euo pipefail

runtime=${SD_VPNC_SESSION_RUNTIME:-/tmp/sd-vpnc-session-registry}
lock_file=$runtime/registry.lock
state_file=$runtime/state
sessions=$runtime/sessions
ready_file=/tmp/sd-vpnc-manager-ready

proc_identity() {
  local pid=$1 stat rest
  [[ -r "/proc/$pid/stat" ]] || return 1
  IFS= read -r stat < "/proc/$pid/stat" || return 1
  rest=${stat##*) }
  [[ "$rest" != "$stat" ]] || return 1
  # After the command name, field 20 is Linux /proc stat field 22 (starttime).
  awk '{ print $20 }' <<<"$rest"
}

write_state() {
  local state=$1 ever=$2 started=$3
  printf '%s\n%s\n%s\n' "$state" "$ever" "$started" > "$runtime/state.tmp"
  mv -f "$runtime/state.tmp" "$state_file"
}

read_state() {
  state= ever= started=
  [[ -r "$state_file" ]] || return 1
  { IFS= read -r state; IFS= read -r ever; IFS= read -r started; } < "$state_file"
  [[ -n "$state" && ( "$ever" == 0 || "$ever" == 1 ) && "$started" =~ ^[0-9]+$ ]]
}

# Run a state transition in a fresh process while holding the shared registry lock.
locked() {
  flock -x "$lock_file" "$0" "__locked-$1" "${@:2}"
}

classify_lease() {
  local file=$1 id pid recorded_start recorded_generation current state
  id=${file##*/}
  if ! { IFS= read -r pid && IFS= read -r recorded_start && IFS= read -r recorded_generation; } < "$file"; then
    printf 'indeterminate %s\n' "$id"; return
  fi
  if [[ ! "$pid" =~ ^[0-9]+$ || ! "$recorded_start" =~ ^[0-9]+$ || -z "$recorded_generation" ]]; then
    printf 'indeterminate %s\n' "$id"; return
  fi
  if [[ "$recorded_generation" != "$generation" ]]; then
    rm -f -- "$file"
    printf 'stale %s\n' "$id"; return
  fi
  if [[ ! -d "/proc/$pid" ]]; then
    rm -f -- "$file"
    printf 'stale %s\n' "$id"; return
  fi
  if ! current=$(proc_identity "$pid" 2>/dev/null); then
    printf 'indeterminate %s\n' "$id"; return
  fi
  IFS= read -r state < "/proc/$pid/stat" || { printf 'indeterminate %s\n' "$id"; return; }
  state=${state##*) }
  state=${state%% *}
  if [[ "$state" == Z || "$current" != "$recorded_start" ]]; then
    rm -f -- "$file"
    printf 'stale %s\n' "$id"; return
  fi
  printf 'live %s\n' "$id"
}

reconcile_locked() {
  local file result category id
  live_count=0; stale_count=0; indeterminate_count=0; indeterminate_ids=
  shopt -s nullglob
  for file in "$sessions"/*; do
    [[ -f "$file" ]] || continue
    result=$(classify_lease "$file")
    read -r category id <<<"$result"
    case $category in
      live) live_count=$((live_count + 1)) ;;
      stale) stale_count=$((stale_count + 1)) ;;
      *) indeterminate_count=$((indeterminate_count + 1)); indeterminate_ids+=" $id" ;;
    esac
  done
  shopt -u nullglob
}

manager_transition_locked() {
  local now elapsed already_reconciled=${1:-0}
  read_state || return 1
  now=$(date +%s)
  if [[ "$state" == WAITING_FIRST_SESSION ]]; then
    elapsed=$((now - started))
    if [[ "$ever" == 0 && $elapsed -ge 30 ]]; then write_state STOPPING "$ever" "$started"; state=STOPPING; fi
  elif [[ "$state" == ACTIVE && "$ever" == 1 ]]; then
    if [[ "$already_reconciled" != 1 ]]; then reconcile_locked; fi
    if [[ $live_count -eq 0 && $indeterminate_count -eq 0 ]]; then
      write_state STOPPING "$ever" "$started"; state=STOPPING
    fi
  fi
}

mark_ready() {
  local identity
  identity=$(proc_identity 1) || { echo 'Cannot identify the VPN manager process.' >&2; return 1; }
  printf '%s\n' "$identity" > "$ready_file.tmp"
  mv -f "$ready_file.tmp" "$ready_file"
}

manager_is_ready() {
  local identity recorded
  identity=$(proc_identity 1) || return 1
  [[ -r "$ready_file" ]] || return 1
  IFS= read -r recorded < "$ready_file" || return 1
  [[ "$recorded" == "$identity" ]]
}

initialize_locked() {
  local generation
  rm -rf -- "$sessions" "$runtime/registered"
  mkdir -m 0700 -p "$sessions" "$runtime/registered"
  generation="$(date +%s)-$$-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"
  printf '%s\n' "$generation" > "$runtime/generation"
  chmod 0600 "$runtime/generation"
  write_state STARTING 0 "$(date +%s)"
  chmod 0600 "$state_file"
}

begin_registration_grace_locked() {
  read_state || return 1
  [[ "$state" == STARTING && "$ever" == 0 ]] || return 1
  write_state WAITING_FIRST_SESSION 0 "$(date +%s)"
}

launch_session() {
  local id=$1 mode=$2; shift 2
  [[ "$id" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo 'Invalid session identifier.' >&2; return 2; }
  local generation identity
  generation=$(cat "$runtime/generation")
  identity=$(proc_identity "$$") || { echo 'Cannot inspect session process identity.' >&2; return 1; }
  locked register "$id" "$$" "$identity" "$generation"
  touch "$runtime/registered/$id"
  local acknowledged=0
  for _ in {1..30}; do
    if [[ -f "$runtime/registered/$id.ack" ]]; then acknowledged=1; break; fi
    sleep 1
  done
  rm -f "$runtime/registered/$id" "$runtime/registered/$id.ack"
  [[ "$acknowledged" == 1 ]] || { echo 'Session coordinator did not acknowledge registration.' >&2; return 1; }
  local -a ssh_args=()
  [[ ! -f "$HOME/.ssh/config" ]] || ssh_args=(-F "$HOME/.ssh/config")
  case "$mode" in
    ssh)
      if [[ $# -gt 0 ]]; then exec ssh "${ssh_args[@]}" "$@"; fi
      echo 'VPN is connected. OpenVPN log: /tmp/openvpn.log'
      exec /usr/local/bin/sd-vpnc-shell
      ;;
    ssh-tmux)
      local host=${1:-} session=${2:-}
      [[ -n "$host" ]] || { echo 'A host is required for ssh-tmux.' >&2; return 2; }
      if [[ -n "$session" && ! "$session" =~ ^[[:alnum:]_.-]+$ ]]; then
        echo 'tmux session names may contain only letters, numbers, ., _, and -.' >&2; return 2
      fi
      if [[ -n "$session" ]]; then exec ssh "${ssh_args[@]}" "$host" -t "tmux new -s '$session' || tmux attach -t '$session'"; fi
      exec ssh "${ssh_args[@]}" "$host"
      ;;
    *) echo "Unknown session mode: $mode" >&2; return 2 ;;
  esac
}

locked_action() {
  local action=$1; shift
  [[ -r "$runtime/generation" ]] || return 1
  generation=$(cat "$runtime/generation")
  case "$action" in
    register)
      local id=$1 pid=$2 identity=$3 wanted_generation=$4
      read_state || return 1
      [[ "$wanted_generation" == "$generation" ]] || { echo 'Manager generation changed.' >&2; return 1; }
      case "$state" in
        WAITING_FIRST_SESSION)
          [[ $(( $(date +%s) - started )) -lt 30 ]] || { echo 'Manager first-session grace expired.' >&2; return 1; }
          ;;
        ACTIVE) ;;
        *) echo 'VPN manager is stopping; retry the request.' >&2; return 1 ;;
      esac
      printf '%s\n%s\n%s\n' "$pid" "$identity" "$generation" > "$sessions/$id.tmp"
      chmod 0600 "$sessions/$id.tmp"
      mv -f "$sessions/$id.tmp" "$sessions/$id"
      write_state ACTIVE 1 "$started"
      ;;
    start-grace)
      begin_registration_grace_locked
      ;;
    acknowledge)
      local id=$1
      read_state || return 1
      [[ "$state" == ACTIVE && -f "$sessions/$id" ]] || { echo 'Session registration is no longer active.' >&2; return 1; }
      touch "$runtime/registered/$id.ack"
      ;;
    status|reconcile|release|stop-if-idle)
      read_state || return 1
      if [[ "$action" == release ]]; then
        local id=$1 file="$sessions/$1" result
        if [[ -f "$file" ]]; then
          result=$(classify_lease "$file")
          # A normal engine-exec return has exited; a catchable host signal does
          # not prove that the in-container process ended, so retain a live lease.
          [[ "$result" == stale\ * ]] && rm -f -- "$file"
        fi
      fi
      reconcile_locked
      if [[ "$action" == stop-if-idle ]]; then
        if [[ "$state" == WAITING_FIRST_SESSION && $live_count -eq 0 && $indeterminate_count -eq 0 ]]; then
          write_state STOPPING "$ever" "$started"; state=STOPPING
        elif [[ "$state" == ACTIVE && $live_count -eq 0 && $indeterminate_count -eq 0 ]]; then
          write_state STOPPING "$ever" "$started"; state=STOPPING
        fi
      else
        manager_transition_locked 1
      fi
      printf 'ownership=sd-vpnc protocol=1 state=%s generation=%s live=%s stale=%s indeterminate=%s' \
        "$state" "$generation" "$live_count" "$stale_count" "$indeterminate_count"
      if [[ $indeterminate_count -gt 0 ]]; then printf ' indeterminate_ids=%s' "${indeterminate_ids# }"; fi
      printf '\n'
      ;;
    watch-once)
      manager_transition_locked
      printf '%s\n' "$state"
      ;;
    *) return 2 ;;
  esac
}

case ${1:-} in
  ready) manager_is_ready ;;
  mark-ready) mark_ready ;;
  initialize)
    mkdir -m 0700 -p "$runtime"
    touch "$lock_file"
    chmod 0600 "$lock_file"
    flock -x "$lock_file" "$0" __locked-initialize
    ;;
  __locked-initialize) initialize_locked ;;
  launch) shift; launch_session "$@" ;;
  status|reconcile|release|stop-if-idle|acknowledge|start-grace)
    action=$1; shift; locked "$action" "$@"
    ;;
  watch)
    while :; do
      state=$(locked watch-once) || exit 1
      [[ "$state" != STOPPING ]] || exit 0
      sleep 1
    done
    ;;
  __locked-register) shift; locked_action register "$@" ;;
  __locked-status|__locked-reconcile|__locked-release|__locked-stop-if-idle|__locked-acknowledge|__locked-start-grace)
    action=${1#__locked-}; shift; locked_action "$action" "$@"
    ;;
  __locked-watch-once) locked_action watch-once ;;
  *) echo "Unknown registry command: ${1:-}" >&2; exit 2 ;;
esac
