sd_vpnc_copy_entry() {
	local source=$1 destination_dir=$2 destination mode
	destination=$destination_dir/${source##*/}
	if [[ -L "$source" ]]; then
		cp -P -- "$source" "$destination"
	elif [[ -d "$source" ]]; then
		[[ -r "$source" && -x "$source" ]] || return 0
		mkdir -p "$destination"
		sd_vpnc_copy_contents "$source" "$destination"
		mode=$(stat -c '%a' -- "$source")
		chmod "$mode" -- "$destination"
	elif [[ -f "$source" ]]; then
		[[ -r "$source" ]] || return 0
		if ! cp --preserve=mode -- "$source" "$destination"; then
			[[ ! -r "$source" ]] && return 0
			return 1
		fi
	fi
}

sd_vpnc_copy_contents() (
	local source_dir=$1 destination_dir=$2 excluded=${3:-} item name
	shopt -s dotglob nullglob
	[[ ! -L "$source_dir" ]] || exit 0
	[[ -d "$source_dir" && -r "$source_dir" && -x "$source_dir" ]] || exit 0
	for item in "$source_dir"/*; do
		name=${item##*/}
		case " $excluded " in
			*" $name "*) continue ;;
		esac
		sd_vpnc_copy_entry "$item" "$destination_dir" || exit $?
	done
)

sd_vpnc_seed_home() {
	local template=${1:-/usr/share/sd-vpnc/home-template} old_umask
	[[ -d "$template" ]] || { printf 'Runtime home template is missing: %s\n' "$template" >&2; return 1; }
	old_umask=$(umask)
	umask 077
	mkdir -p "$HOME/.cache" "$HOME/.local" "$HOME/.local/state" \
		"$HOME/.local/share" "$HOME/.atuin" "$HOME/.atuin/data"
	export XDG_CACHE_HOME="$HOME/.cache"
	export XDG_STATE_HOME="$HOME/.local/state"
	export XDG_DATA_HOME="$HOME/.local/share"
	export ATUIN_HOME="$HOME/.atuin"
	sd_vpnc_copy_contents "$template" "$HOME" '.ssh .cache .local .atuin'
	sd_vpnc_copy_contents "$template/.local" "$HOME/.local" 'state share'
	if [[ ! -L "$template/.local" ]]; then
		sd_vpnc_copy_contents "$template/.local/share" "$HOME/.local/share" 'atuin'
	fi
	umask "$old_umask"
}
